{
  "name": "llm-servescope",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-storage-assets.mjs && vite --host 127.0.0.1 --port 4180 --strictPort",
    "build": "node scripts/prepare-storage-assets.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "test:ui": "playwright test",
    "build:pages": "node scripts/build-pages.mjs",
    "publish:pages": "node scripts/publish-pages.mjs",
    "test:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pyodide": "314.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "3.6.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
